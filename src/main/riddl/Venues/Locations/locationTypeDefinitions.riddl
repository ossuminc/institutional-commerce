type Status is any of {Draft, Open, Closed} with { briefly "Internal status of a Location." }

type Info is {
  id: Venues.LocationId,
  venueId: VenueId,
  name: String,
  description: String,
  directions: String with { briefly "How do you find this location?" },
  //latLong: LatLong,s
  url: URL?,
  capacity: Integer?,
  amenities: String*, //TODO: We may need amenities to be searchable - i.e. I need to find a Location that is handicaped accessible and has a kitchen
  entrances: Address+,
  preferredEntrance: Address,
  isPrivate: Boolean with { briefly "Is this location accessible outside of the organization owning its venue?" },
  reservations: ReservationId*
}

type UpdateInfo is {
  name: String?,
  description: String?,
  directions: String? with { briefly "How do you find this location?" },
  //latLong: LatLong?,
  url: URL?,
  capacity: Integer?,
  amenities: String*, //TODO: We may need amenities to be searchable - i.e. I need to find a Location that is handicaped accessible and has a kitchen
  entrances: Address*,
  preferredEntrance: Address?,
  isPrivate: Boolean? with { briefly "Is this location accessible outside of the organization owning its venue?" }
}

type MetaInfo is {
  createdOn: TimeStamp with { briefly "The Date/Time this venue was created." },
  createdBy: MemberId with { briefly "The member who created this venue" },
  lastUpdated: TimeStamp with { briefly "The Date/Time this venue was last modified." },
  lastUpdatedBy: MemberId with {
    briefly "The member who last modified this venue. This may also be a system user. i.e. they are two months late on payment so the system determines to suspend the venue."
  },
  currentStatus: Venues.LocationContext.Status with {
    briefly "The current state of this venue. Valid states include Draft, Active, Suspended, and Terminated"
  },
  currentOwner: MemberId
} with {
  briefly "Meta data kept about a location that the user does not directly modify. Instead the system updates this info as a Member Owner updates details in the Info type."
}
