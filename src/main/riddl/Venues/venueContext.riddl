type VenueId is Id (ImprovingApp.Venues.VenueContext.Venue) with {
  briefly "Unique identifier for Venue Entity"
}

context VenueContext is {
    include "venueTypeDefinitions"
    include "venueMessages"
    include "venueProjections"

    entity Venue is {

        handler VenueHandler is {
            on command EstablishVenue {
              prompt "morph Venue to Draft state"
              prompt "Copy fields from the command into Draft fields"
              prompt "adjust meta fields to reflect the change set"
              prompt "yield event VenueEstablished"
            }
            on other {
              error "Only EstablishVenue command is allowed in the default state"
            }
        }

        record DraftState is {
            venueInfo: VenueContext.Info,
            maybeLocations: Venues.LocationId*,
            venueMeta: VenueContext.MetaInfo
        }
		    state Draft of Venue.DraftState
        handler DraftVenue is {
            on command EstablishVenue {
              error "Venue already established"
            }
            on command EditVenueInfo {
              prompt "set Draft info fields to EditVenueInfo.info"
              prompt "yield event VenueInfoUpdated"
            }
            on command UpdateVenueStatus {
              prompt "morph Venue to the state provided in UpdateVenueStatus"
              prompt "set MetaInfo to capture change data"
              prompt "yield event VenueInfoUpdated"
            }
            on command AddVenueLocations {
              prompt "add the LocationIds provided in this command to Venue.locations"
              prompt "set MetaInfo to capture change data"
              prompt "yield event VenueInfoUpdated"
            }
        }

        record OpenState is {
            venueInfo: VenueContext.Info,
            maybeLocations: Venues.LocationId*,
            venueMeta: VenueContext.MetaInfo
        }
		    state Open of Venue.OpenState
        handler OpenVenue is {
            on command EstablishVenue {
              error "Venue already established"
            }
            on command EditVenueInfo {
              prompt "set Open info fields to EditVenueInfo.info"
              prompt "yield event VenueInfoUpdated"
            }
            on command UpdateVenueStatus {
              prompt "morph Venue to the state provided in UpdateVenueStatus"
              prompt "set MetaInfo to capture change data"
              prompt "yield event VenueInfoUpdated"
            }
            on command AddVenueLocations {
              prompt "add the LocationIds provided in this command to Venue.locations"
              prompt "set MetaInfo to capture change data"
              prompt "yield event VenueInfoUpdated"
            }
        }

        record ClosedState is {
            orgId: OrganizationId,
            maybeLocations: Venues.LocationId*,
            venueMeta: VenueContext.MetaInfo
        }
		    state Closed of Venue.ClosedState
        handler ClosedVenue is {
            on command EstablishVenue {
              error "Venue already established"
            }
            on command EditVenueInfo {
              prompt "set Closed info fields to EditVenueInfo.info"
              prompt "yield event VenueInfoUpdated"
            }
            on command UpdateVenueStatus {
              prompt "morph Venue to the state provided in UpdateVenueStatus"
              prompt "set MetaInfo to capture change data"
              prompt "yield event VenueInfoUpdated"
            }
            on command AddVenueLocations {
              prompt "add the LocationIds provided in this command to Venue.locations"
              prompt "set MetaInfo to capture change data"
              prompt "yield event VenueInfoUpdated"
            }
        }
    } with {
      option event-sourced
      option available
    }
} with {
  by author James
  by author Alex
}