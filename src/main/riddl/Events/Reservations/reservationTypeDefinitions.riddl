type Status is any of {Draft, OnHold, Reserved, Past, Cancelled} with { briefly "Internal status of a Reservation." }

type Info is {
    range: ImprovingApp.TimeRange,
    title: String,
    description: String,
    location: Venues.LocationId,
    forOrg: OrganizationId
}

type UpdateInfo is {
    range: ImprovingApp.TimeRange?,
    title: String?,
    description: String?,
    forOrg: OrganizationId?
}

type MetaInfo is {
  createdOn: TimeStamp with { briefly "The Date/Time this venue was created." },
  createdBy: MemberId with { briefly "The member who created this venue" },
  lastUpdated: TimeStamp with { briefly "The Date/Time this venue was last modified." },
  lastUpdatedBy: MemberId with { briefly "The member who last modified this venue. This may also be a system user. i.e. they are two months late on payment so the system determines to suspend the venue." },
  currentStatus: ReservationContext.Status with { briefly "The current state of this venue. Valid states include Draft, Active, Suspended, and Terminated" },
  currentOwner: MemberId
} with {
  briefly "Meta data kept about a reservation that the user does not directly modify. Instead the system updates this info as a Member Owner updates details in the Info type."
}
