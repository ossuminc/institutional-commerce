projector OrganizationsView is {
   record Fields {
      orgId: ImprovingApp.OrganizationId, //org-owner & org-member correlation tables
      orgOwner: MemberId,    //org-owner correlation table
      orgMember: MemberId     //org-member correlation table
  }
  handler OrganizationsView is {
      on event ImprovingApp.OrganizationContext.OrganizationEstablished {
          prompt "create row in org table with orgId set to OrganizationEstablished.info.orgId"
          prompt "and set previous row's orgName to OrganizationEstablished.info.name"
          prompt "and set previous row's orgInfo to OrganizationEstablished.info"
      }
      on event MembersAddedToOrganization {
          prompt "create rows in org-member table with orgId set to MembersAddedToOrganization.orgId and orgMember not belonging in MembersAddedToOrganization.newMembers"
      }
      on event MembersRemovedFromOrganization {
          prompt "remove rows in org-member table with orgId set to MembersRemovedFromOrganization.orgId and orgMember not belonging in MembersRemovedFromOrganization.newMembers"
      }
      on event OwnersAddedToOrganization {
          prompt "create rows in org-owner table with orgId set to OwnersAddedToOrganization.orgId and orgOwner not belonging in OwnersAddedToOrganization.newOwners"
      }
      on event OwnersRemovedFromOrganization {
          prompt "remove rows in org-owner table with orgId set to OwnersRemovedFromOrganization.orgId and orgOwner not belonging in OwnersRemovedFromOrganization.newOwners"
      }
      on query FindOrganizationsByMemberOrOwner {
          prompt "if FindOrganizationsByMemberOrOwner.isMember, find FindOrganizationsByMemberOrOwner.memberId in org-member - otherwise do same in org-owner - if not found, return error"
          prompt "and return OrganizationListByMemberOrOwner containing results"
      }
  }
}
