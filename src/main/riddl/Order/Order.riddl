context OrderContext is {
  type OrderId is Id(OrderContext.Order)
  type LineItem is {
    product: SKU,
    quantity: Number,
    unitPrice: Number with {
      described as {
      |This field is calculated and therefore should never be set
      |and instead works more like a function.
    }},
    lineTotal: Number
  }

  type OrderInfo is {
    order_id: OrderId,
    lineItems: LineItem+,
    specialInstructions: String?,
    orderTotal: Number with {
      described as {
      |This field is calculated and therefore should never be set
      |and instead works more like a function.
    }}
  }
  type OrderMetaInfo is {
    order_id: OrderId,
    memberId: MemberId,
    storeId: ImprovingApp.StoreContext.StoreId,
    createdOn: Date,
    lastModifiedBy: MemberId,
    lastModifiedOn: Date
  }
  type OrderInfoUpdate is {
    lineItems: LineItem*,
    specialInstructions: String?
  }
  command CreateOrder is {orderId: OrderId, storeId: ImprovingApp.StoreContext.StoreId, info: OrderInfo, creatingMember: MemberId}
  event OrderCreated is {orderId: OrderId, info: OrderInfo, meta: OrderMetaInfo}
  command SetToPendingOrder is {orderId: OrderId, updatingMember: MemberId}
  event PendingOrderSet is {orderId: OrderId, info: OrderInfo, meta: OrderMetaInfo}
  command SetToInProcessOrder is {orderId: OrderId, updatingMember: MemberId}
  event InProcessOrderSet is {orderId: OrderId, info: OrderInfo, meta: OrderMetaInfo}
  command SetToReadyOrder is {orderId: OrderId, updatingMember: MemberId}
  event ReadyOrderSet is {orderId: OrderId, info: OrderInfo, meta: OrderMetaInfo}
  command DeliverOrder is {orderId: OrderId, updatingMember: MemberId}
  event OrderDelivered is {orderId: OrderId, info: OrderInfo, meta: OrderMetaInfo}
  command UpdateOrderInfo is {orderId: OrderId, update: OrderInfoUpdate, updatingMember: MemberId}
  event OrderInfoUpdated is {orderId: OrderId, info: OrderInfo, meta: OrderMetaInfo}
  command CancelOrder is {orderId: OrderId, cancellingMember: MemberId}
  event OrderCancelled is {orderId: OrderId, info: OrderInfo, meta: OrderMetaInfo}
  query GetOrderInfo is {orderId: OrderId, requestingMember: MemberId}
  result OrderInfoResult is {orderId: OrderId, info: OrderMetaInfo, meta: OrderMetaInfo}
  event LineItemOrdered is {orderId: OrderId, productId: SKU, forMemberId: MemberId}
  event LineItemCancelled is {orderId: OrderId, productId: SKU, forMemberId: MemberId}

  entity Order is {
    handler DefaultOrderHandler is {
      on command CreateOrder {
        prompt "morph Order into Draft state"
        prompt "copy fields from CreateOrder command into the Draft Order"
        prompt "adjust meta fields to reflect the change set"
        prompt "yield OrderCreated event"
      }
      on other {
        error "Only CreateOrder is allowed in the default state."
      }
    }

    record DraftState is {
      info: OrderInfo,
      meta: OrderMetaInfo
    }
    state Draft of Order.DraftState
    handler DraftOrderHandler is {
      on command CreateOrder {
        error "Order has already been created."
      }
      on command UpdateOrderInfo {
        prompt "copy fields from the UpdateOrderInfo command into the Draft Order"
        prompt "adjust meta fields to reflect the change set"
        prompt "yield OrderInfoUpdated event"
      }
      on command SetToPendingOrder {
        prompt "morph order to Pending state"
        prompt "adjust meta fields to reflect change set"
        prompt "yield PendingOrderSet event"
      }
      on command SetToInProcessOrder {
        error "Draft orders may not transition to the InProcess state"
      }
      on command SetToReadyOrder {
        error "Draft orders may not transition to the Ready state"
      }
      on command DeliverOrder {
        error "Draft orders may not transition to the Delivered state"
      }
      on command CancelOrder {
        prompt "morph order to Cancelled state"
        prompt "adjust meta fields to reflect change set"
        prompt "yield OrderCancelled event"
      }
      on query GetOrderInfo {
        prompt "yield OrderInfoResult message"
      }
    }

    record PendingState is {
      info: OrderInfo,
      meta: OrderMetaInfo
    }
    state Pending of Order.PendingState
    handler PendingOrderHandler is {
      on command CreateOrder {
        error "Order has already been created."
      }
      on command UpdateOrderInfo {
        prompt "copy fields from the UpdateOrderInfo command into the Draft Order"
        prompt "adjust meta fields to reflect the change set"
        prompt "yield OrderInfoUpdated event"
      }
      on command SetToPendingOrder {
        error "Pending orders may not transition to the Pending state"
      }
      on command SetToInProcessOrder {
        prompt "morph order to InProcess state"
        prompt "adjust meta fields to reflect change set"
        prompt "yield InProcessOrderSet event"
      }
      on command SetToReadyOrder {
        error "Pending orders may not transition to the Ready state"
      }
      on command DeliverOrder {
        error "Pending orders may not transition to the Delivered state"
      }
      on command CancelOrder {
        prompt "morph order to Cancelled state"
        prompt "adjust meta fields to reflect change set"
        prompt "yield OrderCancelled event"
      }
      on query GetOrderInfo {
        prompt "yield OrderInfoResult message"
      }
    }

    record InProcessState is {
      info: OrderInfo,
      meta: OrderMetaInfo
    }

    state InProcess of Order.InProcessState
    handler InProcessOrderHandler is {
      on command CreateOrder {
        error "Order has already been created."
      }
      on command UpdateOrderInfo {
        error "InProcess Orders may not be modified."
      }
      on command SetToPendingOrder {
        error "Pending orders may not transition to the Pending state"
      }
      on command SetToInProcessOrder {
        error "Draft orders may not transition to the InProcess state"
      }
      on command SetToReadyOrder {
        prompt "morph order to Ready state"
        prompt "adjust meta fields to reflect change set"
        prompt "yield ReadyOrderSet event"
      }
      on command DeliverOrder {
        error "Pending orders may not transition to the Delivered state"
      }
      on command CancelOrder {
        error "InProcess Orders may not be cancelled."
      }
      on query GetOrderInfo {
        prompt "yield OrderInfoResult message"
      }
    }

    record ReadyState is {
      info: OrderInfo,
      meta: OrderMetaInfo
    }
    state Ready of Order.ReadyState
    handler ReadyOrderHandler is {
      on command CreateOrder {
        error "Order has already been created."
      }
      on command UpdateOrderInfo {
        error "Ready Orders may not be modified."
      }
      on command SetToPendingOrder {
        error "Pending orders may not transition to the Pending state"
      }
      on command SetToInProcessOrder {
        error "Draft orders may not transition to the InProcess state"
      }
      on command SetToReadyOrder {
        error "Pending orders may not transition to the Ready state"
      }
      on command DeliverOrder {
        prompt "morph order to Delivered state"
        prompt "adjust meta fields to reflect change set"
        prompt "yield OrderDelivered event"
      }
      on command CancelOrder {
        error "Ready Orders may not be cancelled."
      }
      on query GetOrderInfo {
        prompt "yield OrderInfoResult message"
      }
    }

    record DeliveredState is {
      info: OrderInfo,
      meta: OrderMetaInfo
    }
    state Delivered of Order.DeliveredState
    handler DeliveredOrderHandler is {
      on command CreateOrder {
        error "Order has already been created."
      }
      on command UpdateOrderInfo {
        error "Delivered Orders may not be modified."
      }
      on command SetToPendingOrder {
        error "Pending orders may not transition to the Pending state"
      }
      on command SetToInProcessOrder {
        error "Draft orders may not transition to the InProcess state"
      }
      on command SetToReadyOrder {
        error "Pending orders may not transition to the Ready state"
      }
      on command DeliverOrder {
        morph entity Order to state Order.Delivered with
          record Order.DeliveredState
        prompt "adjust meta fields to reflect change set"
        prompt "yield OrderDelivered event"
      }
      on command CancelOrder {
        error "Delivered Orders may not be cancelled."
      }
      on query GetOrderInfo {
        prompt "yield OrderInfoResult message"
      }
    }

    record CancelledState is {
      info: OrderInfo,
      meta: OrderMetaInfo
    }
    state Cancelled of Order.CancelledState
    handler CancelledOrderHandler is {
      on command CreateOrder {
        error "Order has already been created."
      }
      on command UpdateOrderInfo {
        error "Cancelled Orders may not be modified."
      }
      on command SetToPendingOrder {
        error "Pending orders may not transition to the Pending state"
      }
      on command SetToInProcessOrder {
        error "Draft orders may not transition to the InProcess state"
      }
      on command SetToReadyOrder {
        error "Pending orders may not transition to the Ready state"
      }
      on command DeliverOrder {
        error "Pending orders may not transition to the Delivered state"
      }
      on command CancelOrder {
        error "Delivered Orders may not be cancelled."
      }
      on query GetOrderInfo {
        prompt "yield result OrderInfoResult"
      }
    }
  }
} with {
  option event-sourced
  by author James
  by author Alex
}