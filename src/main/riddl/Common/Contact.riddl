
type MobileNumber is Pattern("\\(([0-9]{3})\\)([0-9]{3})-([0-9]{4})") with {
  briefly "North American Phone Number standard"
}
// FIXME: This pattern works fine on JVM, not so good with ScalaNative.
// Original Pattern: "(?:[a-z0-9!#$%&'*+/=?^_`{|}~-](?:\\.[a-z0-9!#$%&'*+/=?^_`{|}~-])|\"(?:[\x01-\x08\x0b\x0c\x0e-\x1f\x21\x23-\x5b\x5d-\x7f]|\\[\x01-\x09\x0b\x0c\x0e-\x7f])\")@(?:(?:[a-z0-9](?:[a-z0-9-][a-z0-9])?\\.)+[a-z0-9](?:[a-z0-9-][a-z0-9])?|[(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?|[a-z0-9-]*[a-z0-9]:(?:[\x01-\x08\x0b\x0c\x0e-\x1f\x21-\x5a\x53-\x7f]|\\[\x01-\x09\x0b\x0c\x0e-\x7f])+)])"
type EmailAddress is Pattern("([A-Za-z0-9!#$%&'*+/=?^_`{|}~.-]+)@([A-Za-z0-9]([A-Za-z0-9.-][A-Za-z0-9])?)") with {
  briefly "RFC 5322 official standard. See https://emailregex.com"
}
type CAPostalCode is Pattern("[A-Z]\\d[A-Z]\\d[A-Z]\\d") with {
  briefly "A Canadian Postal Code'"
}
type USPostalCode is Pattern("\\d{5}(-\\d{4})?") with {
  briefly "A USA Postal Code"
}
type PostalCode is one of { CAPostalCode, USPostalCode } with {
  briefly "Either a USA or Canadian postal code"
}
// Types for Contact Information

type Address is {
    line1: String,
    line2: String,
    city: String,
    stateProvince: String,
    country: String,
    postalCode: PostalCode
} with {
  briefly "A generalized north american postal address"
}

type Contact is {
    firstName: String,
    lastName: String,
    emailAddress: EmailAddress,
    phone: MobileNumber,
    userName: String
} with {
  briefly "Contact information for an individual"
}

